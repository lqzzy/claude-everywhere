# Listen port and address (0.0.0.0 lets a phone on Tailscale connect)
PORT=4000
HOST=0.0.0.0

# Auth token (required! the phone must send it when connecting). Generate with `openssl rand -hex 32`
AUTH_TOKEN=

# Default working directory when the app starts a new session
DEFAULT_CWD=/Users/qili

# Optional: default model (leave empty to use claude's default)
# DEFAULT_MODEL=opus
